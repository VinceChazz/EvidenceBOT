# ---------------------------------------------------------------------------
# EvidenceBot configuration
# Copy this file to ".env" and paste your key. Never commit ".env".
# ---------------------------------------------------------------------------

# REQUIRED for generated answers and semantic embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Models -----------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# auto = OpenAI embeddings when a key is present, otherwise the offline embedder
EMBEDDING_BACKEND=auto
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
# Optional: point at an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64

# --- Retrieval ---------------------------------------------------------------
MAX_RESULTS_PER_SOURCE=8
RETRIEVAL_WORKERS=6
REQUEST_TIMEOUT_SECONDS=12
REQUEST_RETRIES=2
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# NCBI asks API users to identify themselves (email only, no key required)
NCBI_EMAIL=you@example.org
NCBI_TOOL=EvidenceBot
# Optional NCBI API key raises the E-utilities rate limit from 3 to 10 req/s
# NCBI_API_KEY=
CROSSREF_MAILTO=you@example.org
MAX_FULLTEXT_FETCHES=2
MAX_FULLTEXT_CHARS=12000

# --- Processing --------------------------------------------------------------
CHUNK_SIZE_WORDS=170
CHUNK_OVERLAP_WORDS=40
MIN_CHUNK_WORDS=12

# --- Ranking / evidence gate -------------------------------------------------
TOP_K=10
CANDIDATE_K=30
RELEVANCE_THRESHOLD=0.30
MINIMUM_EVIDENCE_PASSAGES=2
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4
MIN_TERM_OVERLAP=0.15
MIN_QUESTION_COVERAGE=0.55
MIN_EVIDENCE_WORDS=45
CLAIM_SUPPORT_THRESHOLD=0.45
MIN_PASSAGES_FOR_CONSISTENCY=3
# "abstain" (strict) or "answer" for questions phrased as universal guarantees
ABSOLUTE_CLAIM_POLICY=abstain
MAX_GENERATION_ATTEMPTS=2

# --- Behaviour ---------------------------------------------------------------
# When every live source is unreachable, load the clearly-labelled offline
# sample corpus so the pipeline can still be demonstrated. Set to false for
# strictly live-only retrieval.
ENABLE_OFFLINE_SAMPLE_FALLBACK=true
LOG_LEVEL=INFO
